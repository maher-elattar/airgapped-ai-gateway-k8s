flowchart TB
  subgraph p1["Phase 1 — Define the model contract"]
    key["Assign one stable model key"]
    contract["Declare backend Service, port, and API shape"]
    health["Verify the model Service responds directly"]
  end

  subgraph p2["Phase 2 — Publish the route under policy"]
    route["Create one HTTPRoute for the model"]
    policy["Attach the route policy with no grants"]
  end

  subgraph p3["Phase 3 — Prove default deny"]
    denyCheck{"Existing consumers<br/>receive 403?"}
  end

  subgraph p4["Phase 4 — Grant entitlement explicitly"]
    entitle["Add the model to one selected consumer"]
    limits["Add rate-limit entries for that consumer"]
  end

  subgraph p5["Phase 5 — Prove entitlement scope"]
    scopeCheck{"Granted consumer receives 200<br/>and unrelated consumers still 403?"}
  end

  subgraph p6["Phase 6 — Release"]
    tests["Commit 401, 403, 200, and 429 assertions"]
    promote["Promote through the bundle and deployment workflow"]
  end

  halt["Stop — policy attachment or entitlement is incorrect"]

  key --> contract --> health --> route --> policy --> denyCheck
  denyCheck -- "No" --> halt
  denyCheck -- "Yes" --> entitle --> limits --> scopeCheck
  scopeCheck -- "No" --> halt
  scopeCheck -- "Yes" --> tests --> promote

  classDef blocked fill:#fdeded,stroke:#c0392b,color:#7b241c
  class halt blocked
