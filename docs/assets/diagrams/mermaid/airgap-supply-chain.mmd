flowchart LR
  subgraph connected["CONNECTED SIDE — has internet access"]
    direction TB
    lock["sources.lock.yaml<br/>one pinned version and digest per artifact"]
    fetch["Fetch CRDs, charts, images, wheels, and tools<br/>from their canonical upstream sources"]
    verify1["VERIFY 1<br/>check every fetched payload against the lock"]
    pack["Write the bundle<br/>payload + inventory + checksums + the lock itself<br/>split into parts if transfer media requires it"]
  end

  boundary{{"AIR-GAP BOUNDARY<br/>one-way transfer — no network path back"}}

  subgraph disconnected["DISCONNECTED SIDE — no internet access"]
    direction TB
    verify2["VERIFY 2<br/>recompute every checksum against the bundled lock<br/>zero network requests"]
    promote["Promote images into the internal registry"]
    render["Render manifests against the promoted image map"]
    install["Install the compatibility set"]
  end

  lock --> fetch --> verify1 --> pack --> boundary
  boundary --> verify2 --> promote --> render --> install

  classDef gate fill:#eaf6ec,stroke:#27ae60,color:#1e5631
  classDef edge fill:#fdf3e3,stroke:#c87f0a,color:#7a4c06
  classDef contract fill:#eef2fb,stroke:#3b5aa6,color:#1f2f57
  class verify1,verify2 gate
  class boundary edge
  class lock contract
